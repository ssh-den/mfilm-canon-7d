+#if defined(CONFIG_MODULES) && defined(CONFIG_7D206_FULL_CORE)
+/* A background module can persist its state without entering the ML menu.
+ * Share the normal save lock and lifetime guard; report errors to the caller. */
+int module_config_save_now(module_entry_t *module)
+{
+    if (!module || !module->config || !module->name[0]) return -1;
+    for (const char *p=module->name;*p;p++)
+        if (!((*p>='a' && *p<='z') || (*p>='0' && *p<='9') || *p=='_')) return -1;
+    take_semaphore(config_save_sem,0);
+    int rc=-1;
+    if (!ml_shutdown_requested && module_port.done && !module_port.loading && !module_port.result) {
+        char path[128];
+        snprintf(path,sizeof(path),"%s%s.cfg",get_config_dir(),module->name);
+        rc=module_config_save(path,module);
+    }
+    give_semaphore(config_save_sem);
+    return rc;
+}
+#endif
